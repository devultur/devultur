{
	"name": "@devultur/react",
	"version": "1.1.0",
	"description": "React components and hooks for Devultur media: HLS video player, uploads with progress, image cropper and captions",
	"keywords": [
		"react",
		"media",
		"video",
		"hls",
		"video-player",
		"upload",
		"captions"
	],
	"private": false,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/devultur/devultur",
		"directory": "packages/react"
	},
	"homepage": "https://github.com/devultur/devultur#readme",
	"bugs": {
		"url": "https://github.com/devultur/devultur/issues"
	},
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts",
		"dev": "tsup src/index.ts --format esm --dts --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@devultur/core": "workspace:*",
		"hls.js": "^1.6.0",
		"react-easy-crop": "^5.0.0"
	},
	"peerDependencies": {
		"react": ">=19.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"react": "^19.0.0",
		"tsup": "^8.0.0",
		"typescript": "^5.8.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
