{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"declaration": true,
		"declarationMap": false,
		"sourceMap": true,
		"inlineSources": true,
		"outDir": "../../dist/component",
		"rootDir": ".",
		"skipLibCheck": true
	},
	"include": ["."],
	"exclude": ["**/*.test.ts", "**/*.spec.ts"]
}
