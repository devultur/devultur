{
	"name": "@devultur/core",
	"version": "1.4.0",
	"description": "Shared config, types, storage path conventions, media references and URL signing for the Devultur media SDKs",
	"keywords": [
		"media",
		"video",
		"r2",
		"cloudflare",
		"hls",
		"upload",
		"signed-url"
	],
	"private": false,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/devultur/devultur",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/devultur/devultur#readme",
	"bugs": {
		"url": "https://github.com/devultur/devultur/issues"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts",
		"dev": "tsup src/index.ts --format esm --dts --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.700.0",
		"@aws-sdk/s3-request-presigner": "^3.700.0"
	},
	"devDependencies": {
		"tsup": "^8.0.0",
		"typescript": "^5.8.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
