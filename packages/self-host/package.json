{
	"name": "@devultur/self-host",
	"version": "1.1.0",
	"description": "Self-hosted media Worker for Cloudflare: R2 uploads, edge-cached delivery, image transforms, HLS transcode and captions",
	"keywords": [
		"cloudflare-workers",
		"hono",
		"r2",
		"media",
		"video",
		"hls",
		"transcode",
		"ffmpeg"
	],
	"private": false,
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/devultur/devultur",
		"directory": "packages/self-host"
	},
	"homepage": "https://github.com/devultur/devultur#readme",
	"bugs": {
		"url": "https://github.com/devultur/devultur/issues"
	},
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./transcode-container": "./src/transcode/container.ts"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts src/transcode/container.ts --format esm --dts --external cloudflare:workers --external '*.wasm' --clean",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@devultur/core": "workspace:*",
		"@jsquash/avif": "2.1.1",
		"@jsquash/jpeg": "1.6.0",
		"@jsquash/png": "3.1.1",
		"@jsquash/resize": "2.1.1",
		"@jsquash/webp": "1.5.0",
		"hono": "^4.7.0"
	},
	"devDependencies": {
		"@cf-wasm/photon": "0.4.0",
		"@cloudflare/workers-types": "^4.20250620.0",
		"@types/node": "^22.20.0",
		"tsup": "^8.5.1",
		"typescript": "^5.8.0",
		"wrangler": "^4.106.0"
	},
	"publishConfig": {
		"access": "public",
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./transcode-container": {
				"types": "./dist/transcode/container.d.ts",
				"import": "./dist/transcode/container.js"
			}
		}
	}
}
