{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/guides/**", "$TURBO_ROOT$/scripts/copy-guides.mts"],
			"outputs": ["dist/**", "docs/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		}
	}
}
